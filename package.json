{
  "name": "gazkontur",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "validate-config": "tsx scripts/validate-config.ts",
    "build": "npm run validate-config && tsc -b && vite build && node scripts/build-sw.mjs && node --check dist/service-worker.js",
    "preview": "vite preview --host 0.0.0.0",
    "test": "tsx --test tests/*.test.ts",
    "test:e2e": "playwright test",
    "format": "prettier --write src scripts tests"
  },
  "dependencies": {
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.51.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.7.0",
    "pdf-lib": "^1.17.1",
    "prettier": "^3.9.6",
    "sharp": "^0.35.4",
    "tsx": "^4.19.0",
    "typescript": "~5.7.2",
    "vite": "^7.3.6"
  }
}
